<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="people">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="person" maxOccurs="unbounded" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element type="xs:string" name="firstName"/>
              <xs:element type="xs:string" name="familyName"/>
              <xs:element type="xs:int" name="mother" minOccurs="0"/>
              <xs:element type="xs:int" name="father" minOccurs="0"/>
              <xs:element type="xs:int" name="wife" minOccurs="0"/>
              <xs:element type="xs:int" name="husband" minOccurs="0"/>
              <xs:element name="brothers">
                <xs:complexType mixed="true">
                  <xs:sequence>
                    <xs:element type="xs:int" name="brother" maxOccurs="unbounded" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="sisters">
                <xs:complexType mixed="true">
                  <xs:sequence>
                    <xs:element type="xs:int" name="sister" maxOccurs="unbounded" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="sons">
                <xs:complexType mixed="true">
                  <xs:sequence>
                    <xs:element type="xs:int" name="son" maxOccurs="unbounded" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="daughters">
                <xs:complexType mixed="true">
                  <xs:sequence>
                    <xs:element type="xs:int" name="daughter" maxOccurs="unbounded" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute type="xs:int" name="id" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>

    <xs:key name="PersonId">
      <xs:selector xpath=".//person"/>
      <xs:field xpath="@id"/>
    </xs:key>

    <xs:keyref name="HusbandRef" refer="PersonId">
      <xs:selector xpath=".//person"/>
      <xs:field xpath="husband"/>
    </xs:keyref>

    <xs:keyref name="WifeRef" refer="PersonId">
      <xs:selector xpath=".//person"/>
      <xs:field xpath="wife"/>
    </xs:keyref>

    <xs:keyref name="MotherRef" refer="PersonId">
      <xs:selector xpath=".//person"/>
      <xs:field xpath="mother"/>
    </xs:keyref>

    <xs:keyref name="FatherRef" refer="PersonId">
      <xs:selector xpath=".//person"/>
      <xs:field xpath="father"/>
    </xs:keyref>

    <xs:keyref name="BrotherRef" refer="PersonId">
      <xs:selector xpath=".//person/brothers/brother"/>
      <xs:field xpath="."/>
    </xs:keyref>

    <xs:keyref name="SisterRef" refer="PersonId">
      <xs:selector xpath=".//person/sisters/sister"/>
      <xs:field xpath="."/>
    </xs:keyref>

    <xs:keyref name="SonRef" refer="PersonId">
      <xs:selector xpath=".//person/sons/son"/>
      <xs:field xpath="."/>
    </xs:keyref>

    <xs:keyref name="DaughterRef" refer="PersonId">
      <xs:selector xpath=".//person/daughter2s/daughter"/>
      <xs:field xpath="."/>
    </xs:keyref>

  </xs:element>
</xs:schema>